{
  "name": "formbar-app-boilerplate",
  "version": "1.0.0",
  "description": "Production-grade Express boilerplate for Formbar-integrated applications",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "imports": {
    "#config": "./src/config/index.js",
    "#config/*": "./src/config/*",
    "#errors": "./src/errors/index.js",
    "#errors/*": "./src/errors/*",
    "#logging/*": "./src/logging/*",
    "#utils/*": "./src/utils/*",
    "#database": "./src/database/index.js",
    "#database/*": "./src/database/*",
    "#middleware/*": "./src/middleware/*",
    "#services/*": "./src/services/*",
    "#repositories/*": "./src/repositories/*",
    "#auth/*": "./src/auth/*",
    "#authorization/*": "./src/authorization/*",
    "#integrations/*": "./src/integrations/*",
    "#realtime/*": "./src/realtime/*",
    "#validators/*": "./src/validators/*",
    "#models/*": "./src/models/*",
    "#jobs/*": "./src/jobs/*",
    "#controllers/*": "./src/controllers/*",
    "#routes/*": "./src/routes/*"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:prod": "node src/server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "docker:up": "docker compose -f docker-compose.yml -f docker-compose.host.yml up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "db:init": "node scripts/db-init.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:rollback": "node scripts/db-rollback.js",
    "db:seed": "node scripts/db-seed.js",
    "db:clear-pass-data": "node scripts/db-clear-pass-data.js",
    "db:status": "node scripts/db-status.js",
    "db:init:sqlite": "node scripts/db-init.js --provider=sqlite",
    "db:init:postgres": "node scripts/db-init.js --provider=postgres",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "loadtest": "node tools/loadtest/cli.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --omit=dev",
    "outdated": "npm outdated",
    "ci": "npm run lint && npm run test:unit && npm run test:integration && npm run test:security && npm run audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.8",
    "compression": "^1.8.2",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^18.0.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "http-terminator": "^3.2.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "memorystore": "^1.6.8",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sql.js": "^1.14.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  }
}
