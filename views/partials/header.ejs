<header class="site-header">
  <a class="header-link" href="/">Home</a>
  <nav>
    <a class="header-link to-be-removed" href="/">Home</a>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a class="header-link to-be-removed" href="/example">Example</a>
      <a class="header-link" href="/manager">Manager</a>
      <a class="header-link" href="/teacher">Teacher</a>
      <a class="header-link to-be-removed" href="/account"><%= currentUser.display_name %></a>
    <% } else { %>
      <a href="/auth/login">Sign in</a>
    <% } %>
    <div class="language-switcher" data-language-switcher>
      <span class="language-switcher-label" aria-hidden="true">Aa</span>
      <label for="language-select" class="visually-hidden">Language</label>
      <select id="language-select" aria-label="Language">
        <option value="en">English</option>
        <option value="de">Deutsch</option>
        <option value="zh">中文</option>
        <option value="ja">日本語</option>
        <option value="es">Español</option>
        <option value="egyptian">𓂀 Hieroglyphics</option>
        <option value="iroquoian">Iroquoian</option>
      </select>
    </div>
  </nav>
</header>
