<header class="site-header">
  <h4 class="footer-txt">YPass</h4>
  <a class="header-link to-be-removed" href="/">Home</a>
  <nav>
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <a class="header-link to-be-removed" href="/example">Example</a>
      <a class="header-link" href="/manager">Manager</a>
      <a class="header-link" href="/teacher">Teacher</a>
      <a class="header-link to-be-removed" href="/account"><%= currentUser.display_name %></a>
    <% } else { %>
      <a class="header-link" href="/auth/login">Sign in</a>
    <% } %>
    <div class="language-switcher" data-language-switcher>
      <span class="language-switcher-label" aria-hidden="true">Aa</span>
      <select id="language-select" aria-label="Language">
        <option value="en">English</option>
        <option value="es">Español</option>
      </select>
    </div>
  </nav>
</header>
