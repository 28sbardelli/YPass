<section class="staff-page">
  <% if (features.socketIo) { %>
    <script nonce="<%= cspNonce %>" src="/socket.io/socket.io.js" defer></script>
    <script nonce="<%= cspNonce %>" src="/js/teacher-panel.js?v=2" defer></script>
  <% } %>
  <script nonce="<%= cspNonce %>" src="/js/teacher-sort.js?v=3" defer></script>
  <div class="staff-heading">
    <div>
      <p class="kiosk-kicker">Staff workspace</p>
      <h1>Lehrerseite</h1>
      <p class="muted">Review passes that start at your assigned locations.</p>
    </div>
    <a class="button" href="/teacher/appointment">Create appointment</a>
  </div>

  <% if (message) { %>
    <p class="flash flash-success teacher-action-message" role="status" aria-live="polite"><%= message %></p>
  <% } %>
  <section class="staff-section">
    <h2>Your locations</h2>
    <% if (!locations.length) { %>
      <p class="muted">No active locations are assigned to your account.</p>
    <% } else { %>
      <ul>
        <% locations.forEach((location) => { %>
          <li><%= location.name %></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="staff-section">
    <h2>Passes from your locations</h2>
    <% if (!passes.length) { %>
      <p class="muted">No passes are currently starting at your locations.</p>
    <% } else { %>
      <div class="staff-sort">
        <label for="pass-sort">Sort passes</label>
        <select id="pass-sort" data-sort-control="passes">
          <option value="default">Order shown</option>
          <option value="status">Status</option>
          <option value="student">Student (A-Z)</option>
          <option value="date-desc">Newest first</option>
          <option value="date-asc">Oldest first</option>
        </select>
      </div>
      <div class="staff-list" data-sort-list="passes">
        <% passes.forEach((pass) => { %>
          <article class="staff-row" data-sort-status="<%= pass.status %>" data-sort-student="<%= pass.student_name %>" data-sort-date="<%= pass.requested_at %>">
            <div>
              <strong><%= pass.student_name %></strong>
              <span class="muted">ID <%= pass.student_number %></span>
              <p><%= pass.origin_name %> to <%= pass.destination_name %> · <%= pass.status %></p>
            </div>
            <% if (!['completed', 'cancelled', 'expired'].includes(pass.status)) { %>
              <div class="staff-actions">
                <% if (pass.status === 'pending_approval') { %>
                  <form method="post" action="/teacher/pass"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="passId" value="<%= pass.id %>"><input type="hidden" name="action" value="approve"><button type="submit">Approve</button></form>
                <% } %>
                <form method="post" action="/teacher/pass"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="passId" value="<%= pass.id %>"><input type="hidden" name="action" value="cancel"><button type="submit" class="danger-button">Cancel</button></form>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="staff-section">
    <h2>Your appointments</h2>
    <% if (!appointments.length) { %>
      <p class="muted">No appointments.</p>
    <% } else { %>
      <div class="staff-sort">
        <label for="appointment-sort">Sort appointments</label>
        <select id="appointment-sort" data-sort-control="appointments">
          <option value="default">Order shown</option>
          <option value="status">Status (A-Z)</option>
          <option value="student">Student (A-Z)</option>
          <option value="date-asc">Soonest first</option>
          <option value="date-desc">Latest first</option>
        </select>
      </div>
      <div class="staff-list" data-sort-list="appointments">
        <% appointments.forEach((appointment) => { %>
          <article class="staff-row" data-sort-status="<%= appointment.status %>" data-sort-student="<%= appointment.student_name %>" data-sort-date="<%= appointment.scheduled_at %>">
            <div><strong><%= appointment.student_name %></strong><span class="muted"> ID <%= appointment.student_number %></span><p><%= appointment.origin_name %> to <%= appointment.destination_name %> · <%= appointment.scheduled_at %></p></div>
            <span class="status-label"><%= appointment.status %></span>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>
