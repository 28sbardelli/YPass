<section class="staff-page">
  <% if (features.socketIo) { %>
    <script nonce="<%= cspNonce %>" src="/socket.io/socket.io.js" defer></script>
    <script nonce="<%= cspNonce %>" src="/js/teacher-panel.js?v=2" defer></script>
  <% } %>
  <script nonce="<%= cspNonce %>" src="/js/teacher-sort.js?v=4" defer></script>
  <div class="staff-heading">
    <div>
      <h4>
        🗒 <%= new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
      </h4>
      <div class="h-line"></div>
      <h1>Hello, <%= currentUser.display_name.split(',')[1]?.trim() %></h1>
      <li>
        <p class="account-info-box">✉ <%= currentUser.primary_email || 'no email' %></p>
        <form class="inline" method="post" action="/auth/logout">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" />
          <button type="submit">Sign out</button>
        </form>
      </li>
    </div>
    <a class="button" href="/teacher/appointment">+ Create appointment</a>
  </div>

  <% if (message) { %>
    <p class="flash flash-success teacher-action-message" role="status" aria-live="polite"><%= message %></p>
  <% } %>
  <section class="staff-section">
    <h2>Location(s)</h2>
    <% if (!locations.length) { %>
      <p class="muted">No active locations are assigned to your account.</p>
    <% } else { %>
      <ul>
        <% locations.forEach((location) => { %>
          <li class="account-info-box">➤ <%= location.name %></li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="staff-section">
    <h2>Passes</h2>
    <% if (!passes.length) { %>
      <p class="muted">No passes are currently starting at your locations.</p>
    <% } else { %>
      <div class="staff-sort">
        <select id="pass-sort" data-sort-control="passes">
          <option value="default">Order shown</option>
          <option value="status">Status</option>
          <option value="student">Student (A-Z)</option>
          <option value="date-desc">Newest first</option>
          <option value="date-asc">Oldest first</option>
        </select>
      </div>
      <div class="staff-list" data-sort-list="passes">
        <% passes.forEach((pass) => { %>
          <article class="staff-row <%= pass.status %>" data-sort-status="<%= pass.status %>" data-sort-student="<%= pass.student_name %>" data-sort-date="<%= pass.requested_at %>">
            <div>
              <div class="passes-header-wrap">
                <strong><%= pass.student_name %></strong>
                <h4 class="muted"><%= pass.student_number %></h4>
              </div>
              <div class="passes-footer-wrap">
                <%= pass.origin_name %> → <%= pass.destination_name %> 
              </div>
            </div>
            <% if (!['completed', 'cancelled', 'expired'].includes(pass.status)) { %>
              <div class="staff-actions">
                <% if (pass.status === 'pending_approval') { %>
                  <form method="post" action="/teacher/pass">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="passId" value="<%= pass.id %>">
                    <input type="hidden" name="action" value="approve">
                    <button type="submit">Approve</button>
                  </form>
                <% } %>
                <form method="post" action="/teacher/pass"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="passId" value="<%= pass.id %>">
                  <input type="hidden" name="action" value="cancel">
                  <button type="submit" class="danger-button">
                    <%= pass.status === "pending_approval" ? "Decline" : "Cancel" %>
                  </button>
                </form>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="staff-section">
    <h2>Appointments</h2>
    <% if (!appointments.length) { %>
      <p class="muted">No appointments.</p>
    <% } else { %>
      <div class="staff-sort">
        <select id="appointment-sort" data-sort-control="appointments">
          <option value="default">Order shown</option>
          <option value="status">Status (A-Z)</option>
          <option value="student">Student (A-Z)</option>
          <option value="date-asc">Soonest first</option>
          <option value="date-desc">Latest first</option>
        </select>
      </div>
      <div class="staff-list" data-sort-list="appointments">
        <% appointments.forEach((appointment) => { %>
          <article class="staff-row" data-sort-status="<%= appointment.status %>" data-sort-student="<%= appointment.student_name %>" data-sort-date="<%= appointment.scheduled_at %>">
            <div><strong><%= appointment.student_name %></strong><span class="muted"> ID <%= appointment.student_number %></span><p><%= appointment.origin_name %> → <%= appointment.destination_name %> · <%= appointment.scheduled_at %></p></div>
            <span class="status-label"><%= appointment.status %></span>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>
