<% const activeFilters = filters || {}; %>
<section class="staff-page">
  <script nonce="<%= cspNonce %>" src="/js/active-pass-timer.js?v=2" defer></script>
  <% if (sisEnabled) { %><script nonce="<%= cspNonce %>" src="/js/sis-manager.js?v=1" defer></script><% } %>
  <div class="staff-heading"><div><p class="kiosk-kicker">Administration</p><h1>Manager-Bereich</h1><p class="muted">System-wide history and reference data.</p></div></div>
  <form method="get" action="/manager" class="filter-bar">
    <label>Pass status<select name="status"><option value="">All pass statuses</option><% ['pending_approval', 'active', 'arrived', 'timedout', 'completed', 'cancelled', 'expired'].forEach((status) => { %><option value="<%= status %>" <%= activeFilters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label>
    <label>Appointment status<select name="appointmentStatus"><option value="">All appointment statuses</option><% ['scheduled', 'cancelled', 'completed', 'no_show'].forEach((status) => { %><option value="<%= status %>" <%= activeFilters.appointmentStatus === status ? 'selected' : '' %>><%= status %></option><% }) %></select></label>
    <label>Student ID<input name="studentNumber" value="<%= activeFilters.studentNumber || '' %>"></label>
    <button type="submit">Filter</button>
  </form>

  <% if (sisEnabled) { %>
  <details class="staff-section" open>
    <summary>SIS integrations</summary>
    <form class="staff-form manager-form" data-sis-create>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <strong>Add connection</strong>
      <label>Name<input name="connectionName" required maxlength="120"></label>
      <label>Provider<select name="provider"><option value="mock">Mock</option><option value="oneroster">OneRoster</option><option value="skyward">Skyward</option><option value="schoology">Schoology</option></select></label>
      <label>Base URL<input name="baseUrl" type="url" placeholder="https://sis.example.test"></label>
      <label>Protocol<select name="protocol"><option value="oneroster">OneRoster</option><option value="api">Vendor API</option></select></label>
      <label>Platform<select name="platform"><option value="qmlativ">Skyward Qmlativ</option><option value="sms20">Skyward SMS 2.0</option></select></label>
      <label>Student path (optional)<input name="studentPath" placeholder="/api/qmlativ/students"></label>
      <label>OneRoster version<select name="version"><option value="1.1">1.1</option><option value="1.2">1.2</option></select></label>
      <label>Auth type<select name="authType"><option value="bearer">Bearer token</option><option value="basic">Basic</option><option value="oauth1">Schoology OAuth 1.0a</option><option value="apiKey">Skyward API key</option></select></label>
      <label>Username<input name="username" autocomplete="off"></label>
      <label>Password<input name="password" type="password" autocomplete="new-password"></label>
      <label>Token<input name="token" type="password" autocomplete="new-password"></label>
      <label>API key<input name="apiKey" type="password" autocomplete="new-password"></label>
      <label>Consumer key<input name="consumerKey" autocomplete="off"></label>
      <label>Consumer secret<input name="consumerSecret" type="password" autocomplete="new-password"></label>
      <label>Token secret<input name="tokenSecret" type="password" autocomplete="new-password"></label>
      <label>Sync interval (seconds)<input name="syncIntervalSeconds" type="number" min="0" max="86400" value="0"></label>
      <button type="submit">Save connection</button>
      <output data-sis-message class="muted"></output>
    </form>
    <div class="staff-list" data-sis-list>
      <% sisConnections.forEach((connection) => { %>
      <article class="staff-row" data-sis-connection data-connection-id="<%= connection.id %>">
        <div><strong><%= connection.connection_name %></strong><p><%= connection.provider %> · <%= connection.active ? 'Active' : 'Inactive' %> · Last sync: <%= connection.last_synced_at || 'Never' %></p><pre data-sis-history hidden></pre></div>
        <span class="manager-form"><button type="button" data-sis-test>Test</button><button type="button" data-sis-sync>Sync</button><button type="button" data-sis-history-toggle>History</button><button type="button" data-sis-delete>Delete</button></span>
      </article>
      <% }) %>
    </div>
  </details>
  <% } %>

  <details class="staff-section" open><summary>Students</summary>
    <form method="post" action="/manager/students/create" class="staff-form manager-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><strong>Add student</strong>
      <label>Student ID<input name="studentNumber" required maxlength="64"></label>
      <label>Name<input name="studentName" required maxlength="120"></label>
      <label>Status<select name="status"><option value="active">Active</option><option value="inactive">Inactive</option></select></label>
      <button type="submit">Add student</button>
    </form>
    <div class="staff-list"><% students.forEach((student) => { %><form method="post" action="/manager/students/update" class="staff-row manager-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= student.id %>">
      <label>ID<input name="studentNumber" value="<%= student.student_number %>" required maxlength="64"></label><label>Name<input name="studentName" value="<%= student.display_name %>" required maxlength="120"></label><label>Status<select name="status"><option value="active" <%= student.status === 'active' ? 'selected' : '' %>>Active</option><option value="inactive" <%= student.status === 'inactive' ? 'selected' : '' %>>Inactive</option></select></label><button type="submit">Save</button>
    </form><% }) %></div>
  </details>

  <details class="staff-section" open><summary>Locations</summary>
    <form method="post" action="/manager/locations/create" class="staff-form manager-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><strong>Add location</strong>
      <label>Name<input name="name" required maxlength="120"></label><label>Type<select name="type"><option value="round_trip">Round trip</option><option value="one_way">One way</option><option value="bathroom">Bathroom</option></select></label>
      <label>Bathroom<select name="bathroom"><option value="">Unassigned</option><% bathrooms.forEach((bathroom) => { %><option value="<%= bathroom.id %>"><%= bathroom.name %></option><% }) %></select></label>
      <label>Teacher<select name="teacherUserId"><option value="">Unassigned</option><% users.forEach((user) => { %><option value="<%= user.id %>"><%= user.display_name %></option><% }) %></select></label><label><input type="checkbox" name="defaultLocation" value="true"> Default location</label><label>Active<select name="active"><option value="true">Active</option><option value="false">Inactive</option></select></label><button type="submit">Add location</button>
    </form>
    <div class="staff-list"><% locations.forEach((location) => { %><form method="post" action="/manager/locations/update" class="staff-row manager-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= location.id %>">
      <label>Name<input name="name" value="<%= location.name %>" required maxlength="120"></label><label>Type<select name="type"><% ['round_trip', 'one_way', 'bathroom'].forEach((type) => { %><option value="<%= type %>" <%= location.type === type ? 'selected' : '' %>><%= type %></option><% }) %></select></label> <label>Bathroom<select name="bathroom"><option value="">Unassigned</option><% bathrooms.forEach((bathroom) => { %> <option value="<%= bathroom.id %>"<%= String(location.bathroom || '') === String(bathroom.id) ? 'selected' : '' %>><%= bathroom.name %></option><% }) %></select></label><label>Teacher<select name="teacherUserId"><option value="">Unassigned</option><% users.forEach((user) => { %><option value="<%= user.id %>" <%= location.teacher_user_id === user.id ? 'selected' : '' %>><%= user.display_name %></option><% }) %></select></label><label><input type="checkbox" name="defaultLocation" value="true" <%= location.default_location ? 'checked' : '' %>> Default location</label><label>Active<select name="active"><option value="true" <%= location.active ? 'selected' : '' %>>Active</option><option value="false" <%= !location.active ? 'selected' : '' %>>Inactive</option></select></label><button type="submit">Save</button></form><% }) %></div>
  </details>

  <details class="staff-section" open><summary>Kiosks</summary>
    <% if (enrollmentCode) { %><div class="status success"><strong>Enrollment code:</strong> <code><%= enrollmentCode %></code><span class="muted"> Expires in 10 minutes. Enter it on the new kiosk.</span></div><% } %>
    <form method="post" action="/manager/kiosks/enrollment/complete" class="staff-form manager-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><strong>Register kiosk</strong><label>Enrollment code<input name="enrollmentCode" required maxlength="16" placeholder="8K4P-29QX" autocomplete="off"></label><label>Kiosk name<input name="name" required maxlength="120"></label><label>Location<select name="locationId" required><% locations.filter((location) => location.active).forEach((location) => { %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label></label><button type="submit">Register kiosk</button></form>
    <% if (enrollmentCodes.length) { %><div class="staff-list"><% enrollmentCodes.slice(0, 10).forEach((code) => { %><article class="staff-row"><div><strong><%= code.name || 'Unconfigured kiosk' %></strong><p><%= code.type %> · <%= code.used_at ? 'Used' : 'Available' %></p></div><time><%= code.expires_at %></time></article><% }) %></div><% } %>
    
  </details>

  <details class="staff-section" open><summary>Recent timed-out passes</summary><% if (!recentTimedOutPasses.length) { %><p class="muted">No timed-out passes.</p><% } %><div class="staff-list"><% recentTimedOutPasses.forEach((pass) => { %><article class="staff-row"><div><strong><%= pass.student_name %></strong><span class="muted"> ID <%= pass.student_number %></span><p><%= pass.origin_name %> to <%= pass.destination_name %> · timedout<% if (pass.finished_at) { %> · <time data-finished-at="<%= pass.finished_at %>">Finished <%= pass.finished_at_display || pass.finished_at %></time><% } %></p></div><time><%= pass.requested_at %></time></article><% }) %></div><button type="button" class="link-button" data-timeout-modal-open>Show all timed out passes</button></details>
  <div class="timeout-modal" data-timeout-modal hidden>
    <div class="timeout-modal-backdrop" data-timeout-modal-close></div>
    <section class="timeout-modal-panel" role="dialog" aria-modal="true" aria-labelledby="timeout-modal-title">
      <button type="button" class="timeout-modal-close" aria-label="Close timed-out passes" data-timeout-modal-close>&times;</button>
      <h2 id="timeout-modal-title">All timed-out passes</h2>
      <% if (!timedOutPasses.length) { %><p class="muted">No timed-out passes.</p><% } %>
      <div class="staff-list"><% timedOutPasses.forEach((pass) => { %><article class="staff-row"><div><strong><%= pass.student_name %></strong><span class="muted"> ID <%= pass.student_number %></span><p><%= pass.origin_name %> to <%= pass.destination_name %> · timedout<% if (pass.finished_at) { %> · <time data-finished-at="<%= pass.finished_at %>">Finished <%= pass.finished_at_display || pass.finished_at %></time><% } %></p></div><time><%= pass.requested_at %></time></article><% }) %></div>
    </section>
  </div>
  <details class="staff-section" open><summary>All passes</summary><% if (!passes.length) { %><p class="muted">No passes match these filters.</p><% } %><div class="staff-list"><% passes.forEach((pass) => { %><article class="staff-row"><div><strong><%= pass.student_name %></strong><span class="muted"> ID <%= pass.student_number %></span><p><%= pass.origin_name %> to <%= pass.destination_name %> · <%= pass.display_status %><% if (pass.active_live && pass.active_duration) { %> · <span data-active-pass-timer data-active-since="<%= pass.active_since %>" data-active-live="true" data-active-duration-label="<%= pass.active_duration_label %>"><%= pass.active_duration %></span><% } else if (pass.finished_at) { %> · <time data-finished-at="<%= pass.finished_at %>">Finished <%= pass.finished_at_display || pass.finished_at %></time><% } %></p></div><time><%= pass.requested_at %></time></article><% }) %></div></details>
  <details class="staff-section" open><summary>All appointments</summary><% if (!appointments.length) { %><p class="muted">No appointments match these filters.</p><% } %><div class="staff-list"><% appointments.forEach((appointment) => { %><article class="staff-row"><div><strong><%= appointment.student_name %></strong><span class="muted"> ID <%= appointment.student_number %></span><p><%= appointment.origin_name %> to <%= appointment.destination_name %> · <%= appointment.status %></p></div><time><%= appointment.scheduled_at_display %></time></article><% }) %></div></details>
  <details class="staff-section" open><summary>User roles</summary><div class="staff-list"><% users.forEach((user) => { %><form method="post" action="/manager/users/role" class="staff-row manager-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="userId" value="<%= user.id %>"><div><strong><%= user.display_name %></strong><p><%= user.primary_email || 'No email' %> · Current: <%= user.roles?.join(', ') || 'student' %></p></div><label>Role<select name="roleName"><% ['student', 'teacher', 'manager'].forEach((role) => { %><option value="<%= role %>" <%= user.roles?.includes(role) ? 'selected' : '' %>><%= role %></option><% }) %></select></label><button type="submit">Assign role</button></form><% }) %></div></details>
</section>
