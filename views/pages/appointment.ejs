<section class="staff-page narrow-page">
  <a class="button" href="/teacher">← Back to dashboard</a>
  <h1>Create appointment</h1>
  <div class="h-line"></div>
  <p class="small-muted">The student must still scan at a kiosk. An appointment does not create a pass by itself.</p>
  <% if (message) { %><p class="flash <%= message === 'Appointment created.' ? 'flash-success' : 'flash-error' %>"><%= message %></p><% } %>
  <form method="post" action="/teacher/appointment" class="staff-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>
      Student ID<span class="required-note"> *</span>
      <input name="studentNumber" value="<%= form.studentNumber || '' %>" required data-appointment-student-id>
    </label>
    <label>
      <input name="studentName" value="<%= form.studentName || '' %>" required readonly data-appointment-student-name>
    </label>
    <p class="flash flash-error" role="alert" hidden data-appointment-student-warning>Student ID does not exist.</p>
    <label>
      Coming from<span class="required-note"> *</span>
      <select name="originLocationId" required>
        <option value="">Select location</option>
        <% locations.forEach((location) => { %>
          <option value="<%= location.id %>" 
            <%= form.originLocationId === location.id ? 'selected' : '' %>><%= location.name %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>
      Going to<span class="required-note"> *</span>
      <select name="destinationLocationId" required>
        <option value="">Select location</option>
        <% locations.forEach((location) => { %>
          <option value="<%= location.id %>" 
            <%= form.destinationLocationId === location.id ? 'selected' : '' %>>
            <%= location.name %>
          </option>
        <% }) %>
      </select>
    </label>
    <label>
      Scheduled time<span class="required-note"> *</span>
      <input type="datetime-local" name="scheduledAt" value="<%= form.scheduledAt || '' %>" required>
    </label>
    <label>
      Notes
      <textarea name="notes" rows="3">
        <%= form.notes || '' %>
      </textarea>
    </label>
    <button type="submit" class="create-appointment">+ Create appointment</button>
  </form>
</section>
