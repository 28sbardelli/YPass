<section class="kiosk-page">
  <% const waitingForApproval = (typeof action !== 'undefined' && action === 'pending') || (typeof pass !== 'undefined' && pass && pass.status === 'pending_approval');%>
  <div class="kiosk-heading">
    <div>
      <p class="kiosk-kicker">Student movement</p>
      <h1><%= kiosk.name %></h1>
      <p class="kiosk-subtitle">Scan a student ID to request a pass or record a return.</p>
    </div>
    <div class="kiosk-status"><span></span> Ready</div>
  </div>

  <% if (message) { %>
    <div class="kiosk-message kiosk-message-<%= message.type %>" role="status"><%= message.text %></div>
  <% } %>

  <div class="kiosk-grid">
    <section class="kiosk-panel kiosk-scan-panel">
      <div class="panel-heading">
        <div>
          <h2>Identify student</h2>
          <p>Use the barcode scanner or type the student ID.</p>
        </div>
      </div>
      <form method="post" action="/kiosk/scan" class="kiosk-form kiosk-scan-form" <% if (waitingForApproval) { %> aria-disabled="true" <% } %>>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (!kioskSession) { %><input type="hidden" name="kioskCode" value="<%= kioskCode %>"><% } %>
        <label for="studentNumber">Student ID</label>
        <div class="scan-input-wrap">
          <span class="scan-icon" aria-hidden="true">#</span>
          <input id="studentNumber" name="studentNumber" value="<%= form.studentNumber || '' %>" required autofocus autocomplete="off" inputmode="numeric" placeholder="Scan barcode" <% if (waitingForApproval) { %> readonly <% } %> >
        </div>
        <% if (!waitingForApproval) { %><button type="submit" class="primary-button">Continue</button><% } %>
      </form>
      <p class="scanner-note"><%= waitingForApproval ? 'This kiosk is locked until the teacher accepts or cancels the pass.' : 'A USB barcode scanner works like a keyboard. Keep this field focused.' %></p>
    </section>

    <% if (action === 'create' || student) { %>
      <section class="kiosk-panel kiosk-destination-panel">
        <div class="panel-heading">
          <div>
            <h2>Choose destination</h2>
            <p>Student: <strong><%= student.display_name %></strong></p>
          </div>
        </div>
        <form method="post" action="/kiosk/pass" class="kiosk-form" <% if (waitingForApproval) { %> aria-disabled="true" <% } %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <% if (!kioskSession) { %><input type="hidden" name="kioskCode" value="<%= kioskCode %>"><% } %>
          <% if (waitingForApproval) { %>
            <label for="lockedStudentNumber">Student ID</label>
            <input id="lockedStudentNumber" name="studentNumber" value="<%= student.student_number %>" readonly>
            <label for="lockedStudentName">Student</label>
            <input id="lockedStudentName" name="studentName" value="<%= student.display_name %>" readonly>
          <% } else { %>
            <input type="hidden" name="studentNumber" value="<%= student.student_number || form.studentNumber || '' %>">
            <input type="hidden" name="studentName" value="<%= student.display_name || form.studentName || '' %>">
          <% } %>
          <label for="destinationSearch">Search locations</label>
          <input id="destinationSearch" type="search" placeholder="Search by location or teacher" autocomplete="off" data-destination-search <% if (waitingForApproval) { %> disabled <% } %>>
          <input type="hidden" name="destinationLocationId" value="<%= form.destinationLocationId || '' %>" data-destination-value required>
          <div class="destination-list" role="listbox" aria-label="Matching destinations" data-destination-list hidden <% if (waitingForApproval) { %> aria-disabled="true" <% } %>>
            <% destinations.forEach((destination) => { %>
              <button type="button" class="destination-option" role="option" aria-selected="false" data-destination-option data-location-id="<%= destination.id %>" data-location-name="<%= destination.name %>" data-search-text="<%= `${destination.name} ${destination.teacher_name || ''}` %>" hidden <% if (waitingForApproval) { %> disabled <% } %>>
                <strong><%= destination.name %></strong>
                <% if (destination.teacher_name) { %><span><%= destination.teacher_name %></span><% } %>
              </button>
            <% }) %>
            <p class="destination-empty" data-destination-empty hidden>No matching locations.</p>
          </div>
          <% if (!waitingForApproval) { %><button type="submit" class="primary-button">Request teacher approval</button><% } else { %><p class="kiosk-lock-note" role="status">Destination locked: waiting for teacher approval.</p><% } %>
        </form>
      </section>
    <% } %>
  </div>
</section>
