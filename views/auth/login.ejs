<section class="login-page auth-card">
  <h1>Sign in</h1>
  <% if (error) { %>
    <p class="flash flash-error"><%= error %></p>
  <% } %>

  <% if (features.localAuth) { %>
    <form class="login-form" method="post" action="/auth/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="next" value="<%= next %>" />
      <label>Username <input name="username" required maxlength="64" /></label>
      <label>Password <input name="password" type="password" required /></label>
      <button type="submit">Sign in</button>
    </form>
    <p class="login-links"><a href="/auth/register">Create an account</a> · <a href="/auth/forgot">Forgot password</a></p>
  <% } %>

  <% if ((features.localAuth && features.formbarAuth) || (features.localAuth && features.entraAuth) || (features.formbarAuth && features.entraAuth)) { %>
    <div class="auth-provider-divider">or use a school account</div>
  <% } %>
  <div class="auth-providers">
    <% if (features.formbarAuth) { %>
      <a class="button" href="/auth/formbar?next=<%= encodeURIComponent(next) %>">Continue with Formbar</a>
    <% } %>
    <% if (features.entraAuth) { %>
      <a class="button microsoft-login-button" href="/auth/entra?next=<%= encodeURIComponent(next) %>"><img src="/images/microsoft-transparent.png" width="18" height="18" alt="">Continue with Microsoft</a>
    <% } %>
  </div>
</section>
