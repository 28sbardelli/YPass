# Copy this file to .env and fill in values for your environment.
# Never commit real credentials.

# --- App ---
NODE_ENV=development
APP_NAME=formbar-app
APP_BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
TRUST_PROXY=0
WEB_CONCURRENCY=1
MANAGERS=manager@example.com
KIOSK_MANAGER_CODE=change-me-to-a-private-kiosk-code

# --- Feature flags (explicit; do not infer from other settings) ---
LOCAL_AUTH_ENABLED=true
FORMBAR_AUTH_ENABLED=true
ENTRA_AUTH_ENABLED=false
EMAIL_ENABLED=false
SOCKET_IO_ENABLED=true
REDIS_ENABLED=false
SEQ_ENABLED=false
FORMBAR_WS_CLIENT_ENABLED=false
FORMBAR_WS_EXAMPLE_ENABLED=false
FORMBAR_HTTP_EXAMPLE_ENABLED=false
API_ENABLED=true
API_DOCS_ENABLED=true
BACKGROUND_JOBS_ENABLED=false
SIS_ENABLED=false
SIS_HTTP_TIMEOUT_MS=15000
SIS_PAGE_SIZE=100
SIS_RATE_LIMIT_MS=0
LOAD_TEST_FEATURES_ENABLED=false

# local auth email verification/reset: required in production when local auth is on
LOCAL_AUTH_EMAIL_FLOW=disabled
# yorktechapps.com currently uses the login page at /oauth?redirectURL= (legacy_redirect).
# Use authorization_code only against Formbar DEV + Formbar.ts-client (/oauth/authorize).
FORMBAR_OAUTH_MODE=legacy_redirect

# --- Session ---
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=fbapp.sid
SESSION_IDLE_MS=1800000
SESSION_ABSOLUTE_MS=28800000

# --- Security ---
CORS_ORIGINS=
BODY_LIMIT=100kb
HSTS_ENABLED=false
TOKEN_ENCRYPTION_KEY=change-me-to-a-32-byte-base64-or-hex-key!!!!

# --- Database ---
DATABASE_PROVIDER=sqlite
DATABASE_URL=./data/app.sqlite
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_SSL=disable
DATABASE_SSL_CA=
DATABASE_MIGRATE_ON_START=false

# --- Docker Compose (required when using docker compose; ignored by PM2) ---
POSTGRES_PASSWORD=change-me-postgres-password
# REDIS_PASSWORD is also interpolated into the Redis container --requirepass

# --- Redis (required when WEB_CONCURRENCY>1 or clustered Socket.IO/sessions) ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=change-me-redis-password
REDIS_TLS=false
REDIS_KEY_PREFIX=
REDIS_REQUIRED_TIMEOUT_MS=5000

# --- Formbar ---
FORMBAR_BASE_URL=https://formbar.yorktechapps.com
FORMBAR_FRONTEND_URL=
FORMBAR_CLIENT_ID=
FORMBAR_CLIENT_SECRET=
FORMBAR_REDIRECT_URI=http://localhost:3000/auth/formbar/callback
FORMBAR_SCOPES=app.profile.read
FORMBAR_API_KEY=
FORMBAR_PERSIST_TOKENS=false
FORMBAR_MAP_PERMISSIONS=false

# --- Microsoft Entra ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/auth/entra/callback
ENTRA_LOGOUT_URI=http://localhost:3000/auth/logout
ENTRA_SCOPES=openid profile email
ENTRA_PERSIST_TOKENS=false

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_TIMEOUT_MS=10000

# --- Seq ---
SEQ_URL=
SEQ_API_KEY=

# --- Logging ---
LOG_LEVEL=info
LOG_FILE_ENABLED=false
LOG_FILE_DIR=./logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_MAX_FILES=5

# --- Rate limits ---
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=120
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# --- Socket.IO ---
SOCKET_IO_ALLOW_POLLING=false
SOCKET_IO_MAX_BUFFER_BYTES=1000000

# --- Load test CLI (never an HTTP route) ---
LOADTEST_ALLOWED_HOSTS=127.0.0.1,localhost
LOADTEST_ALLOW_PRODUCTION=false